generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ─── Auth.js tables ───────────────────────────────────────────

model User {
  id             String    @id @default(cuid())
  name           String?
  email          String    @unique
  emailVerified  DateTime?
  image          String?
  passwordHash   String?
  settings       Json      @default("{}")
  paperBalance   Float     @default(10000)
  startingBalance Float    @default(10000)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  accounts      Account[]
  sessions      Session[]
  positions     Position[]
  journalEntries JournalEntry[]
  priceAlerts   PriceAlert[]
  customIndicators CustomIndicator[]
  tradingBots   TradingBot[]
  notifications Notification[]
  exchangeCredentials ExchangeCredential[]
}

model Account {
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String
  expires    DateTime

  @@id([identifier, token])
}

// ─── Domain tables ────────────────────────────────────────────

model Position {
  id               String    @id @default(cuid())
  userId           String
  botId            String?   // null = manual trade, set = bot-placed
  asset            String    // "BTCUSDT"
  side             String    // "LONG" | "SHORT"
  size             Float
  entry            Float
  exit             Float?
  stopLoss         Float?
  takeProfit       Float?
  trailingDistance Float?    // price distance for trailing stop (absolute)
  trailingHighWater Float?   // best price reached (high for LONG, low for SHORT)
  pnl              Float?
  status           String    @default("active") // "active" | "closed"

  // Execution mode — "paper" (default, internal accounting only) or "live"
  // (real order placed on an exchange). For "live" rows we keep the
  // exchange + remote order ids so we can reconcile state.
  mode             String    @default("paper")
  exchange         String?   // e.g. "okx"
  exchangeOrderId  String?   // OKX ordId
  exchangeAlgoId   String?   // OKX algoId for SL/TP/trailing (Phase 3)

  openedAt         DateTime  @default(now())
  closedAt         DateTime?
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  bot  TradingBot? @relation(fields: [botId], references: [id], onDelete: SetNull)

  @@index([userId, status])
  @@index([userId, openedAt])
  @@index([botId])
}

model TradingBot {
  id              String    @id @default(cuid())
  userId          String
  name            String

  // Symbol filter — empty = all configured pairs
  symbols         String[]  @default([])

  // Trigger
  // mtf_aligned     — composite multi-TF bias matches `side` and confidence ≥ minConfidence
  // single_tf_bias  — only `tfFilter` timeframe must match
  // rsi_extreme     — fire on RSI overbought/oversold on `tfFilter`
  triggerType     String    @default("mtf_aligned")
  tfFilter        String    @default("4h")  // for single-TF / RSI triggers
  minConfidence   Int       @default(70)    // 0–99

  // Side preference: "ANY" follows bias, or force "LONG" / "SHORT"
  side            String    @default("ANY")

  // Trade params
  positionSizePct Float     @default(5)     // % of paper balance per trade
  stopLossPct     Float?                    // SL as % from entry (always positive)
  takeProfitPct   Float?                    // TP as %
  trailingPct     Float?                    // trailing stop %

  // Concurrency
  maxOpenPositions Int      @default(1)     // bot won't open if it already has N active
  cooldownMinutes  Int      @default(60)    // wait N minutes after a trade before next

  // Execution mode — "paper" runs in the in-browser engine and only
  // touches the DB. "live" places real orders on `exchange` (OKX for
  // now) via the server-side adapter. Default is intentionally paper
  // so accidental "Save" never opens a real position.
  mode            String    @default("paper")
  exchange        String?   // e.g. "okx" — required when mode = "live"
  leverage        Int?      // perpetual leverage (1–125 on OKX); null for spot
  marginMode      String?   // "isolated" | "cross" — OKX perp only

  // State
  enabled         Boolean   @default(true)
  lastRunAt       DateTime?
  lastTradeAt     DateTime?

  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  user      User       @relation(fields: [userId], references: [id], onDelete: Cascade)
  positions Position[]

  @@index([userId, enabled])
}

model PriceAlert {
  id          String    @id @default(cuid())
  userId      String
  symbol      String    // "BTCUSDT"
  price       Float
  direction   String    // "above" | "below"
  message     String?
  active      Boolean   @default(true)
  triggeredAt DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, active])
  @@index([userId, symbol])
}

model CustomIndicator {
  id         String   @id @default(cuid())
  userId     String
  name       String
  expression String   @db.Text
  color      String   @default("#00ffff")
  overlay    Boolean  @default(true)
  enabled    Boolean  @default(true)
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model JournalEntry {
  id         String   @id @default(cuid())
  userId     String
  displayId  String   // "K-9201"
  date       DateTime
  pair       String   // "BTC/USD"
  side       String   // "LONG" | "SHORT"
  entry      Float
  exit       Float
  pnl        Float
  pnlPct    Float
  rrr        String   // "1:3.2"
  strategy   String
  notes      String   @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, date])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  // Type drives the icon/color the UI renders and lets the user filter.
  // Allowed: "alert" | "sl_hit" | "tp_hit" | "bot_trade" | "trade" |
  //          "briefing" | "system"
  type      String
  title     String
  body      String?  @db.Text
  // Structured payload for click-to-context — e.g. { symbol, positionId,
  // alertId, pnl, side, price }. Schema-free so we can iterate without
  // migrations.
  meta      Json     @default("{}")
  read      Boolean  @default(false)
  archived  Boolean  @default(false)
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // Common access pattern: list unread+unarchived for the current user
  // sorted by createdAt desc.
  @@index([userId, read, archived, createdAt])
  @@index([userId, createdAt])
}

// ─── Exchange credentials ─────────────────────────────────────
//
// API keys for live trading. Secrets are AES-256-GCM encrypted at
// rest using a key derived from AUTH_SECRET — see src/lib/crypto.ts.
// We store ciphertext + iv + authTag (all base64) per field. The
// passphrase column is OKX-specific (their API requires a 3rd factor).
model ExchangeCredential {
  id                  String   @id @default(cuid())
  userId              String
  exchange            String   // "okx" (currently the only supported one)
  label               String?  // optional user-given nickname

  // AES-GCM ciphertexts — never logged, never returned by GET
  apiKeyCipher        String   @db.Text
  apiKeyIv            String
  apiKeyTag           String

  apiSecretCipher     String   @db.Text
  apiSecretIv         String
  apiSecretTag        String

  passphraseCipher    String?  @db.Text
  passphraseIv        String?
  passphraseTag       String?

  // Optional non-secret hints — first/last 4 of the public api key so
  // the UI can render "OKX • ABCD…1234" without decrypting.
  apiKeyHint          String?

  // Trade lock — must be true to allow live order placement. Defaults
  // to false so a freshly-saved key cannot trade until user opts in.
  tradeEnabled        Boolean  @default(false)

  lastTestedAt        DateTime?
  lastTestOk          Boolean?
  lastTestError       String?

  createdAt           DateTime @default(now())
  updatedAt           DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  // One credential per user per exchange — keep it simple. If they
  // need multi-account later, drop this and add a label-based unique.
  @@unique([userId, exchange])
}
